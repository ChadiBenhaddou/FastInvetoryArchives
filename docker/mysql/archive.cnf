[mysqld]
# Sized for a 16 GB PC shared with OCR + LLM; raise on 32 GB machines.
innodb_buffer_pool_size = 1G
innodb_log_file_size = 256M
max_connections = 100
skip-name-resolve
# Arabic + French: full Unicode everywhere.
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

[client]
default-character-set = utf8mb4

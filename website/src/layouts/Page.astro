---
// Inner page: H1, introduction, prose content, optional side menu of sibling pages, conversion block.
import Base from './Base.astro';
import CtaBand from '../components/CtaBand.astro';

interface Crumb { name: string; href: string }
interface Props {
    title: string;
    h1?: string;
    description: string;
    lead?: string;
    breadcrumbs: Crumb[];
    jsonLd?: object[];
    offer?: 'inventaire' | 'sur-mesure' | 'both';
    siblings?: { href: string; label: string }[];
    siblingsTitle?: string;
}
const { title, h1 = title, description, lead, breadcrumbs, jsonLd = [], offer = 'both', siblings = [], siblingsTitle = 'Dans cette section' } = Astro.props;
const path = Astro.url.pathname;
---

<Base title={title} description={description} breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
    <div class:list={['grid gap-10', siblings.length && 'lg:grid-cols-[1fr_16rem]']}>
        <article>
            <h1 class="text-3xl font-bold leading-tight text-ink sm:text-4xl">{h1}</h1>
            {lead && <p class="mt-4 max-w-3xl text-lg leading-relaxed text-stone-600">{lead}</p>}
            <div class="prose-site mt-8"><slot /></div>
        </article>
        {siblings.length > 0 && (
            <aside class="lg:pt-2">
                <nav aria-label={siblingsTitle} class="rounded-xl border border-stone-200 bg-white p-4 lg:sticky lg:top-24">
                    <p class="px-2 text-sm font-semibold text-ink">{siblingsTitle}</p>
                    <ul class="mt-2 space-y-0.5 text-sm">
                        {siblings.map((s) => (
                            <li><a href={s.href} aria-current={s.href === path ? 'page' : undefined} class:list={['block rounded-md px-2 py-1.5', s.href === path ? 'bg-brand-50 font-semibold text-brand-700' : 'text-stone-600 hover:bg-stone-100']}>{s.label}</a></li>
                        ))}
                    </ul>
                </nav>
            </aside>
        )}
    </div>
    <slot name="after" />
    <CtaBand offer={offer} />
</Base>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { isProduction, site } from '../config/site.mjs';
import { breadcrumbLd } from '../lib/schema.mjs';

interface Crumb { name: string; href: string }
interface Props {
    title: string;
    description: string;
    /** Path of the canonical page when it differs (pagination, duplicates). */
    canonicalPath?: string;
    ogType?: 'website' | 'article';
    ogImage?: string;
    noindex?: boolean;
    jsonLd?: object[];
    breadcrumbs?: Crumb[];
    /** Full width content (home page) instead of the centred container. */
    wide?: boolean;
}

const { title, description, canonicalPath, ogType = 'website', ogImage = '/og-default.png', noindex = false, jsonLd = [], breadcrumbs = [], wide = false } = Astro.props;
const fullTitle = title.includes(site.productName) ? title : `${title} | ${site.productName}`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url).href;
const robots = !isProduction || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
// organizationLd() is null while the company name is not set: dropped rather than published empty.
const structured = [...jsonLd, ...(breadcrumbs.length ? [breadcrumbLd(breadcrumbs)] : [])].filter(Boolean);
---

<!doctype html>
<html lang="fr" dir="ltr" data-noindex={noindex ? 'page' : undefined}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta name="robots" content={robots} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="alternate" type="application/rss+xml" title={`${site.productName} — articles`} href="/rss.xml" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta property="og:type" content={ogType} />
        <meta property="og:locale" content="fr_MA" />
        <meta property="og:site_name" content={site.productName} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={new URL(ogImage, site.url).href} />
        <meta name="twitter:card" content="summary_large_image" />
        {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
        {structured.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
        <slot name="head" />
    </head>
    <body class="flex min-h-screen flex-col">
        <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2">Aller au contenu</a>
        <Header />
        <main id="contenu" class="flex-1">
            {breadcrumbs.length > 0 && (
                <div class="mx-auto w-full max-w-6xl px-5 pt-6">
                    <Breadcrumbs items={breadcrumbs} />
                </div>
            )}
            {wide ? <slot /> : <div class="mx-auto w-full max-w-6xl px-5 py-8 sm:py-12"><slot /></div>}
        </main>
        <Footer />
        {site.cfAnalyticsToken && isProduction && (
            <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.cfAnalyticsToken })}></script>
        )}
    </body>
</html>

---
import { CATEGORIES, formatDate, postPath } from '../lib/posts.mjs';
interface Props { post: any }
const { post } = Astro.props;
---

<article class="flex h-full flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:shadow-md">
    <p class="text-xs font-medium uppercase tracking-wide text-brand-700">{CATEGORIES[post.data.category]}</p>
    <h3 class="mt-2 text-lg font-semibold leading-snug text-ink">
        <a href={postPath(post)} class="hover:underline">{post.data.title}</a>
    </h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">{post.data.description}</p>
    <p class="mt-4 text-xs text-stone-500"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></p>
</article>

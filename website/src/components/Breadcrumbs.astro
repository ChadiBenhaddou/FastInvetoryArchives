---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---

<nav aria-label="Fil d'Ariane" class="text-sm text-stone-500">
    <ol class="flex flex-wrap items-center gap-1.5">
        {items.map((item, i) => (
            <li class="flex items-center gap-1.5">
                {i > 0 && <span aria-hidden="true">›</span>}
                {i === items.length - 1 ? <span aria-current="page" class="text-stone-700">{item.name}</span> : <a href={item.href} class="hover:text-stone-800 hover:underline">{item.name}</a>}
            </li>
        ))}
    </ol>
</nav>

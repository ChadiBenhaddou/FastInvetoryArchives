---
// Visible FAQ; the page passes the same items to faqLd() so the structured data matches what is shown.
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Questions fréquentes' } = Astro.props;
---

<section class="mt-16" aria-labelledby="faq-title">
    <h2 id="faq-title" class="text-2xl font-semibold text-ink">{title}</h2>
    <div class="mt-6 divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white">
        {items.map((item) => (
            <details class="group px-5 py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-ink">
                    {item.q}
                    <span class="text-xl text-brand-600 transition group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="mt-3 leading-relaxed text-stone-600">{item.a}</p>
            </details>
        ))}
    </div>
</section>

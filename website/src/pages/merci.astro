---
import Base from '../layouts/Base.astro';
---

<Base title="Demande envoyée" description="Votre demande a bien été envoyée. Nous vous répondons par e-mail." noindex>
    <div class="mx-auto max-w-2xl py-10 text-center">
        <h1 class="text-3xl font-bold text-ink">Merci, votre demande est envoyée</h1>
        <p class="mt-4 text-lg text-stone-600">Nous vous répondons par e-mail. En attendant, nos guides pratiques peuvent vous aider à préparer votre projet.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/blog/" class="rounded-md bg-brand-600 px-5 py-3 font-semibold text-white hover:bg-brand-700">Lire les guides</a>
            <a href="/" class="rounded-md border border-stone-300 px-5 py-3 font-semibold text-ink hover:bg-white">Retour à l’accueil</a>
        </div>
    </div>
</Base>

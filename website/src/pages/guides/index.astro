---
// Hub of the topic clusters: each theme with its articles, newest first.
import Base from '../../layouts/Base.astro';
import { CATEGORIES, postPath, publishedPosts } from '../../lib/posts.mjs';

const posts = await publishedPosts();
const clusters = Object.entries(CATEGORIES)
    .map(([key, label]) => ({ key, label, posts: posts.filter((p) => p.data.category === key) }))
    .filter((c) => c.posts.length > 0);
---

<Base
    title="Guides de la gestion des archives, par thème"
    description="Les guides pratiques classés par thème : inventaire et récolement, numérisation et OCR, logiciels et outils, applications sur mesure."
    breadcrumbs={[{ name: 'Accueil', href: '/' }, { name: 'Guides par thème', href: '/guides/' }]}
>
    <h1 class="text-3xl font-bold text-ink sm:text-4xl">Guides par thème</h1>
    <p class="mt-4 max-w-3xl text-lg text-stone-600">Choisissez un thème pour trouver les guides qui y répondent. Tous les articles, du plus récent au plus ancien, sont dans <a href="/blog/" class="font-medium text-brand-700 hover:underline">Guides et articles</a>.</p>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
        {clusters.map((c) => (
            <section class="rounded-xl border border-stone-200 bg-white p-6" aria-labelledby={`theme-${c.key}`}>
                <h2 id={`theme-${c.key}`} class="text-lg font-semibold text-ink">{c.label}</h2>
                <ul class="mt-3 space-y-2">
                    {c.posts.map((p) => <li><a href={postPath(p)} class="text-brand-700 hover:underline">{p.data.title}</a></li>)}
                </ul>
            </section>
        ))}
    </div>
</Base>

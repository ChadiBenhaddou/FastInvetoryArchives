# Copy to .env for local builds (never commit .env). In production these values live in:
#   - Cloudflare Pages → site project → Settings → Variables and secrets (PUBLIC_*);
#   - GitHub → Settings → Secrets and variables → Actions (SEO automation);
#   - Cloudflare Pages → dashboard project (Access + dispatch).
# Full list with where each one goes: docs/CONFIGURATION-EXTERNE.md

# ── Public site identity (build time). Production needs PUBLIC_SITE_URL, PUBLIC_PUBLISHER_NAME and a phone
#    or an e-mail; everything else is optional and only shown when set. The site has no form. ──
SITE_ENV=preview                       # production | preview | development (Cloudflare sets CF_PAGES_BRANCH)
PRODUCTION_BRANCH=main
PUBLIC_SITE_URL=https://inventaire-archives-site.pages.dev
PUBLIC_PUBLISHER_NAME=                 # person responsible for the site (mentions légales)
PUBLIC_CONTACT_PHONE=                  # e.g. 0612345678 → shown 06 12 34 56 78, WhatsApp +212 6 12 34 56 78
PUBLIC_WHATSAPP=true                   # false = no WhatsApp buttons
PUBLIC_CONTACT_EMAIL=
PUBLIC_ORG_NAME=                       # company name; default: the publisher's name
PUBLIC_ORG_LEGAL_FORM=
PUBLIC_ORG_ADDRESS=
PUBLIC_ORG_CITY=
PUBLIC_ORG_RC=
PUBLIC_ORG_ICE=
PUBLIC_AUTHOR_NAME=
PUBLIC_CF_ANALYTICS_TOKEN=             # optional, Cloudflare Web Analytics (no cookies)
PUBLIC_GOOGLE_SITE_VERIFICATION=       # optional, Search Console meta tag

# ── SEO automation (GitHub Actions secrets/variables; local runs only for testing) ──
SEO_LIVE=false                         # false = dry run with fixtures, no request, no cost
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SEO_DAILY_BUDGET_USD=1
SEO_MONTHLY_BUDGET_USD=15
SEO_UNKNOWN_CALL_MAX_USD=0.2
SEO_MAX_REQUESTS_PER_RUN=12
SEO_CACHE_DAYS=30
SEO_STALE_DAYS=90
SEO_RESEARCH_DAILY=true
ANTHROPIC_API_KEY=
SEO_WRITER_MODEL=claude-opus-5-5
SEO_REVIEWER_MODEL=claude-opus-5-5
SEO_AI_MONTHLY_BUDGET_USD=20
SEO_AI_PRICES_JSON=                    # optional price override, see scripts/seo/llm.mjs
SEO_MIN_WORDS=650
SEO_AUTHOR_NAME=
AUTO_PUBLISH=true
MAX_ARTICLES_PER_DAY=1
PUBLISH_HOUR=9                         # Morocco time

# ── Private dashboard (separate Pages project) ──
ACCESS_TEAM_DOMAIN=                    # <equipe>.cloudflareaccess.com
ACCESS_AUD=                            # Application Audience (AUD) tag
DASHBOARD_ADMINS=                      # comma-separated e-mails allowed to trigger actions
GITHUB_DISPATCH_TOKEN=                 # fine-grained token: this repository, Actions read/write only
GITHUB_REPOSITORY=owner/repo
GITHUB_REF=main
DISPATCH_PER_HOUR=10

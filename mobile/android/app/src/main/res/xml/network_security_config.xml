<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext anywhere and only system certificate authorities (the app makes no network calls). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

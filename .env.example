# Docker Compose settings for the archive inventory stack.
# Generate a real .env with scripts/init-env.ps1 (Windows) or scripts/init-env.sh (Ubuntu):
# it fills in random secrets. Never commit .env.

APP_VERSION=dev
APP_ENV=production
APP_DEBUG=false
HTTP_PORT=80

# Host folder for imports, images and backups.
#   Windows: C:/ArchiveInventory     Ubuntu: /srv/archive
ARCHIVE_HOST_ROOT=C:/ArchiveInventory

APP_KEY=
DB_DATABASE=archive
DB_USERNAME=archive
DB_PASSWORD=
DB_ROOT_PASSWORD=
MEILI_MASTER_KEY=

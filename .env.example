# Docker Compose settings for the archive inventory stack.
# Generate a real .env with scripts/init-env.ps1 (Windows) or scripts/init-env.sh (Ubuntu):
# it fills in random secrets. Never commit .env.

APP_VERSION=dev
APP_ENV=production
APP_DEBUG=false
HTTP_PORT=80

# Host folder for imports, images and backups.
#   Windows: C:/ArchiveInventory     Ubuntu: /srv/archive
ARCHIVE_HOST_ROOT=C:/ArchiveInventory

# OCR engine: "windows" = Windows 11 Snipping Tool OCR (install windows-ocr\setup.ps1 on the PC;
# PaddleOCR is used while it is not running), "paddle" = PaddleOCR only (always on Ubuntu).
OCR_ENGINE=windows
# Local AI for the document fields: "false" = fast rules (~1 s per photo in total), "true" = the
# LLM (better titles/summaries, ~2.5 min per photo on a CPU).
LLM_ENABLED=false
# Photos processed in parallel. 3 with the Windows OCR (measured best on a 4-core PC: ~0.8 s per
# photo in total); 2 with PaddleOCR, much heavier (Ubuntu).
PIPELINE_WORKERS=3

APP_KEY=
DB_DATABASE=archive
DB_USERNAME=archive
DB_PASSWORD=
DB_ROOT_PASSWORD=
MEILI_MASTER_KEY=

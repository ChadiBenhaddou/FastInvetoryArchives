{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "archive-inventory/manifest/v1",
    "title": "Phone export manifest (manifest.json at the root of the export ZIP)",
    "type": "object",
    "required": ["format_version", "export_id", "device_letter", "agent_name", "app_version", "exported_at", "sequence_range", "voided_sequences", "boxes"],
    "additionalProperties": false,
    "properties": {
        "format_version": { "const": 1 },
        "export_id": { "type": "string", "format": "uuid" },
        "device_letter": { "type": "string", "pattern": "^[ACDEFGHJKLMNPQRTUVWXY]$" },
        "agent_name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "app_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "exported_at": { "type": "string", "format": "date-time" },
        "sequence_range": {
            "description": "from/to: lowest and highest box sequence in this ZIP (null if only voided codes). last_issued: the phone counter at export time.",
            "type": "object",
            "required": ["from", "to", "last_issued"],
            "additionalProperties": false,
            "properties": {
                "from": { "type": ["integer", "null"], "minimum": 1, "maximum": 9999 },
                "to": { "type": ["integer", "null"], "minimum": 1, "maximum": 9999 },
                "last_issued": { "type": "integer", "minimum": 0, "maximum": 9999 }
            }
        },
        "voided_sequences": {
            "description": "Codes issued then cancelled on the phone: not gaps, the box was never filled.",
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 9999 }
        },
        "boxes": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["code", "sequence", "location", "created_at", "closed_at", "photos"],
                "additionalProperties": false,
                "properties": {
                    "code": { "type": "string", "pattern": "^[ACDEFGHJKLMNPQRTUVWXY]-\\d{4}-[ACDEFGHJKLMNPQRTUVWXY]$" },
                    "sequence": { "type": "integer", "minimum": 1, "maximum": 9999 },
                    "location": {
                        "type": "object",
                        "required": ["room", "shelf", "row"],
                        "additionalProperties": false,
                        "properties": {
                            "room": { "type": ["string", "null"] },
                            "shelf": { "type": ["string", "null"] },
                            "row": { "type": ["string", "null"] }
                        }
                    },
                    "created_at": { "type": "string", "format": "date-time" },
                    "closed_at": { "type": "string", "format": "date-time" },
                    "photos": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "required": ["sequence", "type", "file", "sha256", "width", "height", "taken_at", "quality"],
                            "additionalProperties": false,
                            "properties": {
                                "sequence": { "type": "integer", "minimum": 0 },
                                "type": { "enum": ["code_photo", "document"] },
                                "file": { "type": "string", "pattern": "^boxes/[A-Z]-\\d{4}-[A-Z]/\\d{3}(_code)?\\.jpg$" },
                                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                                "width": { "type": "integer", "minimum": 1 },
                                "height": { "type": "integer", "minimum": 1 },
                                "taken_at": { "type": "string", "format": "date-time" },
                                "quality": {
                                    "type": "object",
                                    "required": ["sharpness", "brightness", "override", "cropped"],
                                    "additionalProperties": false,
                                    "properties": {
                                        "sharpness": { "type": "number" },
                                        "brightness": { "type": "number" },
                                        "override": { "type": "boolean", "description": "Kept by the agent despite failing the quality check" },
                                        "cropped": { "type": "boolean" }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
